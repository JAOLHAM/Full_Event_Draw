{
  "name": "luckydraw-nextjs-typescript",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:logic": "node --experimental-strip-types --test tests/*.test.mjs",
    "test": "npm run test:logic",
    "test:all": "npm run typecheck && npm run test:logic",
    "test:k6:smoke": "k6 run tests/performance/smoke.js",
    "test:k6:load": "k6 run tests/performance/read-only-load.js"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@supabase/supabase-js": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
